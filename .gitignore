# ANDP runtime namespace — secrets, state, build artefacts, metrics, reports.
# Everything ANDP produces or reads-but-never-commits lives here, so a single
# line covers it. `andp.yml` (declarative config) stays versioned at the root.
.andp/

# Pre-.andp/ locations. Nothing writes here any more, but existing checkouts
# still hold these — they must never be committed just because ANDP moved on.
secrets.yml
build/
metrics/
artifacts/
dashboard.html
governance_report.md

*.ipa
*.xcarchive
*.pkg
*.dmg

# GitHub
.github/local_config.yml

# Claude Code personal overrides for this project
.claude/settings.local.json
